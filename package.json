{
  "name": "steam-tracker",
  "version": "2.0.0",
  "description": "Obsidian plugin that syncs Steam games, playtime and achievements into your vault.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
